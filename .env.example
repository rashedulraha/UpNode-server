PORT=8000
NODE_ENV=production
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=https://api.yourdomain.com
CLIENT_URL=https://yourdomain.com

# Production Database (Neon Serverless PostgreSQL with SSL)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Production Caching & Message Queue (Upstash Redis with TLS/SSL)
REDIS_URL="rediss://default:your_upstash_password@your-endpoint.upstash.io:6379"

# External Integration Keys
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="UpNode Alerts <alerts@yourdomain.com>"
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret


REDIS_URL=""